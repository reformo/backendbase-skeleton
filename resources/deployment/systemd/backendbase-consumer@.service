[Unit]
Description=Backendbase queue consumer for %I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backendbase
Group=backendbase
WorkingDirectory=/opt/backendbase/current
Environment=BACKENDBASE_ENV=production
EnvironmentFile=/run/backendbase/runtime.env
ExecStart=/usr/bin/php -d zend.exception_ignore_args=1 bin/backendbase queue:consume %I
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/backendbase/current/var
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
