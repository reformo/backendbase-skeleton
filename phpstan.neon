parameters:
  level: 8
  tmpDir: ./artifacts/phpstan
  paths:
    - src/
    - tests/
    - config/
    - public/
    - bin/check-coverage.php
    - bin/check-openapi-tags.php
    - bin/openapi-tags.php
    - bin/check-documentation-links.php
    - bin/composer-supply-chain.php
    - bin/update-quality-report.php
    - bin/tolgee/sync-support.php
    - bin/dev/message-viewer.php
    - bin/dev/message-viewer/
    - resources/database/
