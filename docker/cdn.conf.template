proxy_cache_path /var/cache/nginx/cdn levels=1:2 keys_zone=cdn:10m max_size=100m inactive=1h use_temp_path=off;

server {
    listen 80;
    server_name _;

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    location = / {
        return 404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://ministack:4566/${BUCKET_NAME}/;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_cache cdn;
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status always;
    }
}
