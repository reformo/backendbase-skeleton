# Local development examples only. These credentials and keys are public.
# Replace them with independent secrets before deployment.
BACKENDBASE_SERVICE_NAME=backendbase
BACKENDBASE_ENV=dev
EXAMPLE_API_CORS_ORIGIN=http://127.0.0.1:8080
BACKENDBASE_LOGGER_HANDLER=stream
BACKENDBASE_LOGGER_LEVEL=debug
BACKENDBASE_DEV_MYSQL_PORT=3306
BACKENDBASE_DEV_MYSQL_ROOT_PASSWORD=backendbase_root!
BACKENDBASE_DEV_MYSQL_DATABASE=backendbase
BACKENDBASE_DEV_MYSQL_USER=backendbase_user
BACKENDBASE_DEV_MYSQL_PASSWORD=backendbase+dev-
BACKENDBASE_DB_DSN=mysql://backendbase_user:backendbase+dev-@127.0.0.1:3306/backendbase?charset=utf8mb4
BACKENDBASE_DEV_RABBITMQ_PORT=5672
BACKENDBASE_DEV_RABBITMQ_MANAGEMENT_PORT=15672
BACKENDBASE_DEV_RABBITMQ_USER=backendbase
BACKENDBASE_DEV_RABBITMQ_PASSWORD=backendbase
BACKENDBASE_DEV_RABBITMQ_VHOST=/
BACKENDBASE_RABBITMQ_HOST=127.0.0.1
BACKENDBASE_RABBITMQ_PORT=5672
BACKENDBASE_RABBITMQ_USER=backendbase
BACKENDBASE_RABBITMQ_PASSWORD=backendbase
BACKENDBASE_RABBITMQ_VHOST=/
BACKENDBASE_RABBITMQ_QUEUE=backendbase-queue
BACKENDBASE_RABBITMQ_EXCHANGE=backendbase
BACKENDBASE_RABBITMQ_EXCHANGE_TYPE=direct
BACKENDBASE_RABBITMQ_CONNECTION_TIMEOUT=3
BACKENDBASE_RABBITMQ_READ_WRITE_TIMEOUT=35
BACKENDBASE_RABBITMQ_HEARTBEAT=15
BACKENDBASE_RABBITMQ_PREFETCH_COUNT=1
BACKENDBASE_QUEUE_DRIVER=rabbitmq
BACKENDBASE_DEV_REDIS_PORT=6379
BACKENDBASE_DEV_REDIS_INSIGHT_PORT=8001
BACKENDBASE_REDIS_HOST=127.0.0.1
BACKENDBASE_REDIS_PORT=6379
BACKENDBASE_DEV_AWS_PORT=4566
BACKENDBASE_DEV_CDN_PORT=8081
BACKENDBASE_DEV_STACKPORT_PORT=8082
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
AWS_ENDPOINT=http://127.0.0.1:4566
AWS_SQS_QUEUE=backendbase-queue
AWS_SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/backendbase-queue
AWS_SNS_SMS_TYPE=Transactional
AWS_SNS_SENDER_ID=Backendbase
BACKENDBASE_SMS_DRIVER=sns
# Optional Twilio examples. Supply real credentials before selecting twilio.
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_AUTH_TOKEN=00000000000000000000000000000000
# TWILIO_FROM=+12025550123
TWILIO_TIMEOUT_SECONDS=5
# Optional Netgsm examples. Supply real credentials before selecting netgsm.
# NETGSM_USERNAME=example-user
# NETGSM_PASSWORD=replace-with-netgsm-password
# NETGSM_SENDER=Backendbase
NETGSM_ENCODING=TR
NETGSM_TIMEOUT_SECONDS=5
BACKENDBASE_EMAIL_DRIVER=ses
# Optional SMTP examples. Supply your server settings before selecting smtp.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=example-user
# SMTP_PASSWORD=replace-with-smtp-password
SMTP_ENCRYPTION=starttls
SMTP_TIMEOUT_SECONDS=5
# Firebase stays disabled until a real project and credentials are available.
# FIREBASE_PROJECT_ID=backendbase-example
# FIREBASE_CREDENTIALS_PATH=var/secrets/firebase-service-account.json
FIREBASE_TIMEOUT_SECONDS=5
OBJECT_STORE_ACCESS_KEY=test
OBJECT_STORE_SECRET_KEY=test
OBJECT_STORE_REGION=eu-central-1
OBJECT_STORE_ENDPOINT=http://127.0.0.1:4566
BUCKET_NAME=backendbase-v3
CDN_BASE_URL=http://127.0.0.1:8081
EXAMPLE_API_KEY=local-api-key
USER_API_CORS_ORIGIN=http://127.0.0.1:8080
SYSTEM_ADMIN_API_CORS_ORIGIN=http://127.0.0.1:8080
# The default Docker Redis service has no authentication.
# Enable these only after configuring matching Redis credentials.
# BACKENDBASE_REDIS_USERNAME=default
# BACKENDBASE_REDIS_PASSWORD=replace-with-redis-password
BACKENDBASE_REDIS_TLS=false
# Public examples: each Base64 value decodes to a distinct 32-byte key.
BACKENDBASE_USER_JWT_ISSUER=http://127.0.0.1:8080/user-api
BACKENDBASE_USER_JWT_AUDIENCE=user-api
BACKENDBASE_USER_JWT_KEY_ID=user-local-1
BACKENDBASE_USER_JWT_KEY=dXNlci1sb2NhbC1leGFtcGxlLWtleS0xLS0tLS0tLS0=
# Enable both previous-key settings only during an intentional key rotation.
# BACKENDBASE_USER_JWT_PREVIOUS_KEY_ID=user-local-0
# BACKENDBASE_USER_JWT_PREVIOUS_KEY=dXNlci1sb2NhbC1leGFtcGxlLWtleS0wLS0tLS0tLS0=
BACKENDBASE_ADMIN_JWT_ISSUER=http://127.0.0.1:8080/system-admin-api
BACKENDBASE_ADMIN_JWT_AUDIENCE=system-admin-api
BACKENDBASE_ADMIN_JWT_KEY_ID=admin-local-1
BACKENDBASE_ADMIN_JWT_KEY=YWRtaW4tbG9jYWwtZXhhbXBsZS1rZXktMS0tLS0tLS0=
# BACKENDBASE_ADMIN_JWT_PREVIOUS_KEY_ID=admin-local-0
# BACKENDBASE_ADMIN_JWT_PREVIOUS_KEY=YWRtaW4tbG9jYWwtZXhhbXBsZS1rZXktMC0tLS0tLS0=
BACKENDBASE_IDENTITY_ENCRYPTION_KEY_ID=proof-local-1
BACKENDBASE_IDENTITY_ENCRYPTION_KEY=cHJvb2YtbG9jYWwtZXhhbXBsZS1rZXktMS0tLS0tLS0=
# BACKENDBASE_IDENTITY_PREVIOUS_ENCRYPTION_KEY_ID=proof-local-0
# BACKENDBASE_IDENTITY_PREVIOUS_ENCRYPTION_KEY=cHJvb2YtbG9jYWwtZXhhbXBsZS1rZXktMC0tLS0tLS0=
BACKENDBASE_IDENTITY_OWNERSHIP_SENDER=no-reply@reformo.net
BACKENDBASE_IDENTITY_TOKEN_LIFETIME_SECONDS=900
