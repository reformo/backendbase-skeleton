<?xml version="1.0"?>
<ruleset name="Backendbase Cyclomatic Complexity">
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="cache" value="artifacts/.phpcs-complexity-cache"/>
    <arg name="colors"/>
    <arg value="nps"/>

    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>public</file>
    <file>bin</file>
    <file>resources/database</file>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="15"/>
            <property name="absoluteComplexity" value="15"/>
        </properties>
    </rule>
</ruleset>
