#!/usr/bin/env php
<?php
declare(strict_types=1);

$projectRoot = __DIR__.'/..';
chdir($projectRoot);

require 'vendor/autoload.php';

use Symfony\Component\Console\Application;
use DI\ContainerBuilder;
use Dotenv\Dotenv;
use Laminas\ConfigAggregator\ConfigAggregator;
use Laminas\ConfigAggregator\PhpFileProvider;

$dotenv = Dotenv::createUnsafeImmutable(dirname(__DIR__));
$dotenv->safeLoad();
error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);
$containerBuilder = new ContainerBuilder();

$configGenerator = new ConfigAggregator([
    new PhpFileProvider('config/autoload/*'),
    new PhpFileProvider('config/console/*')
]);
// Set up settings
$settings = require 'config/settings.php';
$settings($containerBuilder, $configGenerator->getMergedConfig());
// Set up dependencies
$dependencies = require 'config/dependencies.php';
$dependencies($containerBuilder);

// Set up commands
$commandDependencies = require 'config/commands.php';
$commands = $commandDependencies($containerBuilder);

// Build PHP-DI Container instance
$container = $containerBuilder->build();

$application = new Application();

foreach ($commands as $command) {
    $commandFQCN = $container->get($command);
    $application->addCommand($commandFQCN);
}

$application->run();
